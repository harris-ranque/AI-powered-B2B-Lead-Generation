# Genni Web App Environment Configuration

# Convex Backend
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Clerk Authentication (React/Vite - NOT Next.js)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# CrewAI Worker API Configuration
VITE_CREWAI_URL=http://localhost:8080
VITE_CREWAI_API_KEY=your_secure_api_key_change_in_production

# Stripe Payment Processing
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Pricing Configuration (USD amounts displayed to users)
# IMPORTANT: Change these values to update pricing across entire frontend
# Starter Plan (Free)
VITE_PRICING_STARTER_MONTHLY=0
VITE_PRICING_STARTER_YEARLY=0

# Professional Plan
VITE_PRICING_PROFESSIONAL_MONTHLY=149
VITE_PRICING_PROFESSIONAL_YEARLY=119

# Business Plan  
VITE_PRICING_BUSINESS_MONTHLY=449
VITE_PRICING_BUSINESS_YEARLY=359

# Enterprise Plan
VITE_PRICING_ENTERPRISE_MONTHLY=999
VITE_PRICING_ENTERPRISE_YEARLY=799

# Stripe Price IDs (get these from your Stripe Dashboard after creating products)
# Professional Plan Price IDs
VITE_STRIPE_PROFESSIONAL_PRICE_ID_MONTHLY=price_professional_monthly_id_here
VITE_STRIPE_PROFESSIONAL_PRICE_ID_YEARLY=price_professional_yearly_id_here

# Business Plan Price IDs
VITE_STRIPE_BUSINESS_PRICE_ID_MONTHLY=price_business_monthly_id_here
VITE_STRIPE_BUSINESS_PRICE_ID_YEARLY=price_business_yearly_id_here

# Enterprise Plan Price IDs
VITE_STRIPE_ENTERPRISE_PRICE_ID_MONTHLY=price_enterprise_monthly_id_here
VITE_STRIPE_ENTERPRISE_PRICE_ID_YEARLY=price_enterprise_yearly_id_here

# PostHog Analytics (Optional)
VITE_POSTHOG_KEY=phc_your_posthog_key_here
VITE_POSTHOG_HOST=

# Sentry (Optional but recommended for production)
# Move the DSN out of code and set it here or in your deploy env
VITE_SENTRY_DSN=

# Development/Production Mode
VITE_NODE_ENV=development
