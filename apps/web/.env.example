# =============================================================================
# Genni Web — Environment Variables (Vite)
# =============================================================================
# Copy to .env.local and fill in values:
#   cp apps/web/.env.example apps/web/.env.local
#
# Required vars are checked by `node troubleshoot-env.js` during build.
# Server-side API keys (OpenAI, FindyMail, etc.) belong in apps/convex-backend/.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Convex deployment URL (from `npx convex dev` or Convex dashboard)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk publishable key (pk_test_... or pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# -----------------------------------------------------------------------------
# RECOMMENDED — Core product features
# -----------------------------------------------------------------------------

# Google Maps Places Autocomplete (location picker in Lead Discovery)
VITE_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — Analytics & monitoring
# -----------------------------------------------------------------------------

VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# OPTIONAL — UI / product flags
# -----------------------------------------------------------------------------

VITE_SHOW_PRICING=false
VITE_SUPPORT_EMAIL=

# -----------------------------------------------------------------------------
# OPTIONAL — Billing (checkout testing)
# -----------------------------------------------------------------------------

VITE_FASTSPRING_STORE_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
