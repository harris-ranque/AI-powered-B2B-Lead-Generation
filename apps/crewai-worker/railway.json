{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "hypercorn app.main:app --bind \"[::]:$PORT\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "always",
    "numReplicas": 1
  },
  "service": {
    "internalPort": 8080
  }
}