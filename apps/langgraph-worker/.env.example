# LangGraph Worker Environment Variables Example
# Copy this file to .env and fill in your values

# Core Configuration
API_KEY=your_secure_api_key_change_in_production
LANGGRAPH_API_KEY=your_secure_api_key_change_in_production
CONVEX_URL=https://your-convex-deployment.convex.cloud
PORT=8080

# ==========================================
# AI API KEYS
# ==========================================

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Research API Keys
TAVILY_API_KEY=tvly-your_tavily_api_key_here
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key_here

# LangSmith (optional - for debugging/tracing)
LANGSMITH_API_KEY=ls_your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=genni-langgraph-worker

# ==========================================
# CREDIT COST CONFIGURATION
# ==========================================

# Base credit costs for each operation
CREDIT_COST_SEARCH=1
CREDIT_COST_LEAD_ENRICHMENT=2
CREDIT_COST_EMAIL_GENERATION=3
CREDIT_COST_EMAIL_SEQUENCE=5
CREDIT_COST_AI_ANALYSIS=2
CREDIT_COST_DEEP_RESEARCH=5

# ==========================================
# DEEP RESEARCH CONFIGURATION
# ==========================================

# Enable/disable deep research globally
DEEP_RESEARCH_ENABLED=true

# Minimum user tier for deep research (free, pro, enterprise)
DEEP_RESEARCH_MIN_TIER=pro

# Confidence threshold - trigger deep research below this score (0.0-1.0)
DEEP_RESEARCH_CONFIDENCE_THRESHOLD=0.5

# Data completeness threshold - trigger deep research below this score (0.0-1.0)
DEEP_RESEARCH_DATA_THRESHOLD=0.6

# Minimum missing data points to trigger deep research (1-5)
DEEP_RESEARCH_MIN_MISSING_POINTS=3

# High-value lead threshold in USD - always trigger deep research above this
DEEP_RESEARCH_HIGH_VALUE_THRESHOLD=1000

# ==========================================
# DATA VALIDATION CONFIGURATION
# ==========================================

# Minimum data completeness score to avoid deep research (0.0-1.0)
DATA_VALIDATION_MIN_SCORE=0.6

# Recent news time window in months
DATA_VALIDATION_NEWS_MONTHS=6

# ==========================================
# AI CONFIGURATION
# ==========================================

# Confidence thresholds
AI_CONFIDENCE_LOW=0.3
AI_CONFIDENCE_MEDIUM=0.6
AI_CONFIDENCE_HIGH=0.8

# Relevance scoring weights (should sum to 1.0)
AI_WEIGHT_PAIN_POINTS=0.4
AI_WEIGHT_VALUE_MATCHES=0.3
AI_WEIGHT_CONFIDENCE=0.3

# Timeout settings (in milliseconds)
AI_TIMEOUT_BASIC=30000
AI_TIMEOUT_DEEP=120000

# ==========================================
# ENVIRONMENT
# ==========================================

NODE_ENV=development
