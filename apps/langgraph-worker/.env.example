# =============================================================================
# Genni LangGraph Worker — Environment Variables
# =============================================================================
# Copy to .env, fill in values, then start the worker:
#   cp .env.example .env
#   pip install -r requirements.txt
#   pnpm dev
#
# Never commit .env — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Worker authentication
# -----------------------------------------------------------------------------
# Shared secret between Convex and this worker (NOT a vendor API key).
# Must match LANGGRAPH_API_KEY in apps/convex-backend/.env.local
# Minimum 32 characters (startup validation requirement).

API_KEY=dev-local-shared-secret-change-me-32chars

# Alternative names accepted by the worker (API_KEY takes precedence if set):
# LANGGRAPH_API_KEY=dev-local-shared-secret-change-me-32chars

# -----------------------------------------------------------------------------
# REQUIRED — AI providers
# -----------------------------------------------------------------------------

OPENAI_API_KEY=sk-

# Research tiers: Tavily (basic) → Perplexity (pro/deep)
TAVILY_API_KEY=tvly-
PERPLEXITY_API_KEY=pplx-

# -----------------------------------------------------------------------------
# REQUIRED — Convex webhook callback
# -----------------------------------------------------------------------------

CONVEX_URL=https://dashing-coyote-96.convex.cloud

# Auto-built from CONVEX_URL if omitted (.cloud → .convex.site):
# WEBHOOK_URL=https://dashing-coyote-96.convex.site/webhooks/langgraph/email-completed

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

PORT=8080
ENVIRONMENT=development
DEBUG=false

# -----------------------------------------------------------------------------
# OPTIONAL — Model configuration
# -----------------------------------------------------------------------------

DEFAULT_MODEL=gpt-5-mini
TEMPERATURE=0.7
MAX_TOKENS=2000

# Agent-specific token budgets (defaults are fine for local dev)
# BUSINESS_INTELLIGENCE_MAX_TOKENS=16000
# EMAIL_GENERATION_MAX_TOKENS=16000
# QUALITY_ASSURANCE_MAX_TOKENS=16000

# -----------------------------------------------------------------------------
# OPTIONAL — Tavily tuning
# -----------------------------------------------------------------------------

# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_TIMEOUT=5.0

# -----------------------------------------------------------------------------
# OPTIONAL — Perplexity tuning (speed vs depth)
# -----------------------------------------------------------------------------

# Sonar Pro HTTP timeout per company (default 35s — reduces false timeouts vs 20s)
# PERPLEXITY_SONAR_PRO_TIMEOUT_SECONDS=35

# Deep research timeout (default 120s, was 180s)
# PERPLEXITY_DEEP_RESEARCH_TIMEOUT_SECONDS=120

# Escalate to deep research only when 3+ of 5 data points missing (default 3)
# DEEP_RESEARCH_MIN_MISSING_POINTS=3

# Confidence gate for deep research when 2+ points missing (default 0.45)
# DEEP_RESEARCH_CONFIDENCE_THRESHOLD=0.45

# Disable deep research entirely for faster runs
# DEEP_RESEARCH_ENABLED=false

# -----------------------------------------------------------------------------
# OPTIONAL — LangSmith tracing (LangGraph Studio)
# -----------------------------------------------------------------------------

# LANGSMITH_API_KEY=ls_
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=genni-local

# -----------------------------------------------------------------------------
# OPTIONAL — Sentry
# -----------------------------------------------------------------------------

# SENTRY_DSN=
