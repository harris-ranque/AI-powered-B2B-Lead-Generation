{
  "name": "@genni/langgraph-worker",
  "version": "2.0.0",
  "private": true,
  "description": "Python FastAPI LangGraph worker service",
  "scripts": {
    "dev": "python3 -m uvicorn app.main:app --reload --port 8080",
    "start": "gunicorn app.main:app -w 4 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:$PORT",
    "build": "echo 'Python app - no build step required'",
    "type-check": "python3 -m py_compile app/main.py",
    "lint": "echo 'Python linting not configured yet'",
    "install-deps": "pip install -r requirements.txt",
    "test": "python3 test_comprehensive_integration.py",
    "test:api": "python3 test_api_integrations.py",
    "test:integration": "python3 test_comprehensive_integration.py",
    "test:all": "python3 test_comprehensive_integration.py && python3 test_api_integrations.py"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
