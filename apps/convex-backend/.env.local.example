# Convex Backend Environment Variables
# Copy this file to .env.local and fill in your actual values

# API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
FINDYMAIL_API_KEY=your-findymail-api-key-here
ICYPEAS_API_KEY=your-icypeas-api-key-here

# Enrichment Provider Configuration
# Options: findymail, icypeas
ENRICHMENT_PROVIDER=findymail

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here
STRIPE_CONNECT_CLIENT_ID=ca_your-stripe-connect-client-id-here

# CrewAI Worker Configuration
CREWAI_URL=http://localhost:8080
CREWAI_API_KEY=your-secure-api-key-change-in-production
CREWAI_WEBHOOK_SECRET=your-webhook-secret-here

# FindyMail Configuration
FINDYMAIL_WEBHOOK_SECRET=your-findymail-webhook-secret-here

# Admin Configuration
ADMIN_EMAILS=admin@example.com,admin2@example.com
DEVELOPER_EMAIL=dev@example.com

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Email Service Configuration (optional)
EMAIL_SERVICE_API_KEY=your-email-service-api-key-here
EMAIL_FROM_ADDRESS=noreply@genni.com
EMAIL_FROM_NAME=Genni

# Database Encryption (optional)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_WEBHOOK_RETRIES=true
ENABLE_ANALYTICS=true
ENABLE_CACHING=true

# Performance Configuration
MAX_CONCURRENT_SEARCHES=10
MAX_LEADS_PER_BATCH=50
API_RATE_LIMIT=100

# External Service Timeouts (milliseconds)
GOOGLE_MAPS_TIMEOUT=10000
FINDYMAIL_TIMEOUT=15000
CREWAI_TIMEOUT=120000
STRIPE_TIMEOUT=10000

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_PERFORMANCE_MONITORING=true
SENTRY_DSN=your-sentry-dsn-here

# Security
JWT_SECRET=your-jwt-secret-key-here
SESSION_SECRET=your-session-secret-here
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com