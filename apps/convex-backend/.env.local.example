# =============================================================================
# Genni Convex Backend — Environment Variables
# =============================================================================
# Copy to .env.local, fill in values, then start the backend:
#   cp .env.local.example .env.local
#   npx convex dev
#
# Convex CLI uses this file for deployment config and syncs vars to your
# dev deployment. You can also set individual vars with:
#   npx convex env set VARIABLE_NAME "value"
#
# Never commit .env.local — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Convex deployment (auto-created by `npx convex dev` if missing)
# -----------------------------------------------------------------------------

CONVEX_DEPLOYMENT=dev:dashing-coyote-96

# -----------------------------------------------------------------------------
# REQUIRED — Lead discovery & enrichment
# -----------------------------------------------------------------------------

GOOGLE_MAPS_API_KEY=
FINDYMAIL_API_KEY=

# -----------------------------------------------------------------------------
# REQUIRED — LangGraph worker connection
# -----------------------------------------------------------------------------
# LANGGRAPH_API_KEY is a shared secret YOU choose — not from a vendor.
# Must match API_KEY (or LANGGRAPH_API_KEY) in apps/langgraph-worker/.env
# Use at least 32 characters (worker startup validation requirement).

LANGGRAPH_URL=http://localhost:8080
LANGGRAPH_API_KEY=dev-local-shared-secret-change-me-32chars

# -----------------------------------------------------------------------------
# REQUIRED — Clerk authentication
# -----------------------------------------------------------------------------

CLERK_SECRET_KEY=sk_test_
CLERK_WEBHOOK_SECRET=whsec_
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Optional: authorize Clerk user sync migrations
CLERK_SYNC_TOKEN=

# -----------------------------------------------------------------------------
# REQUIRED — Application config
# -----------------------------------------------------------------------------

APP_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com

# Optional: developer notifications
DEVELOPER_EMAIL=

# -----------------------------------------------------------------------------
# REQUIRED by env validator — OpenAI (also set on LangGraph worker)
# -----------------------------------------------------------------------------

OPENAI_API_KEY=sk-

# -----------------------------------------------------------------------------
# REQUIRED — FastSpring billing (use placeholders for local dev if needed)
# -----------------------------------------------------------------------------

FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=
FASTSPRING_WEBHOOK_SECRET=
FASTSPRING_PRIVATE_KEY=
FASTSPRING_STORE_ID=
FASTSPRING_ACCESS_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — FindyMail async webhooks
# -----------------------------------------------------------------------------

FINDYMAIL_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — Export / SSE token signing
# -----------------------------------------------------------------------------

EXPORT_TOKEN_SECRET=
SSE_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — Encrypt user-provided API keys (enterprise BYOK)
# -----------------------------------------------------------------------------

USER_API_KEY_SECRET=
