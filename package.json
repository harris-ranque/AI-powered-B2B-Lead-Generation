{
  "name": "genni-app",
  "version": "1.0.0",
  "description": "AI-powered lead generation platform with intelligent email sequences",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "start:web": "turbo start --filter=@genni/web",
    "start:worker": "turbo start --filter=@genni/langgraph-worker",
    "start:convex": "turbo start --filter=@genni/convex-backend",
    "dev:web": "turbo dev --filter=@genni/web",
    "dev:worker": "turbo dev --filter=@genni/langgraph-worker",
    "dev:convex": "turbo dev --filter=@genni/convex-backend",
    "deploy:convex": "turbo deploy --filter=@genni/convex-backend",
    "clean": "turbo clean",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "test": "turbo test",
    "install-deps": "turbo install-deps",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.0",
    "turbo": "^1.10.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}