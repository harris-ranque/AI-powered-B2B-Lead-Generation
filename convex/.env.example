# Convex Backend Environment Variables
# Copy this file to .env.local and fill in your actual values

# API Keys
OPENAI_API_KEY=sk-your_openai_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
FINDYMAIL_API_KEY=your_findymail_api_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CONNECT_CLIENT_ID=ca_your_stripe_connect_client_id

# CrewAI Worker Configuration
CREWAI_URL=http://localhost:8080
CREWAI_API_KEY=your_secure_api_key_change_in_production

# Admin Configuration
ADMIN_EMAILS=admin@example.com
DEVELOPER_EMAIL=dev@example.com

# App URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Webhook URLs
STRIPE_WEBHOOK_URL=https://your-convex-deployment.convex.cloud/stripe-webhook
CREWAI_WEBHOOK_URL=https://your-convex-deployment.convex.cloud/crewai-webhook

# Railway Production URLs (update when deployed)
# CREWAI_URL=https://your-crewai-railway-app.railway.app
# APP_URL=https://your-frontend-railway-app.railway.app