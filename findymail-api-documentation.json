{"openapi":"3.1.1","info":{"title":"Findymail API documentation","description":"This documentation aims to provide all the information you need to work with our API.\n\n<b>Rate limit</b>: all endpoints have a concurrent rate limit of 300 simultaneous requests, unless stated otherwise.","version":"1.0.0"},"servers":[{"url":"https://app.findymail.com"}],"tags":[{"name":"Email Verifier","description":""},{"name":"Contacts","description":""},{"name":"Email Finder","description":""},{"name":"Misc","description":""},{"name":"Phone Finder","description":""},{"name":"User","description":""}],"components":{"securitySchemes":{"default":{"type":"http","scheme":"bearer","description":"You can retrieve your token by visiting <a href=\"/user/api-tokens\">API page</a>."}}},"security":[{"default":[]}],"paths":{"/api/verify":{"post":{"summary":"Verify an email for potential bounce","operationId":"verifyAnEmailForPotentialBounce","description":"Uses one verifier credit on all attempted verification","parameters":[],"responses":{"200":{"description":"","content":{"text/plain":{"schema":{"type":"string","examples":["{ \"email\": \"john@example.com\", \"verified\" : true, \"provider\": 'Google'}"]}}}},"402":{"description":"Error : Not enough credits","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Not enough credits"]}},"examples":[{"error":"Not enough credits"}]}}}},"423":{"description":"Error : Subscription is paused","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Subscription is paused"]}},"examples":[{"error":"Subscription is paused"}]}}}}},"tags":["Email Verifier"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","description":"Email to verify","nullable":false,"examples":["shirley.purdy@example.net"]}},"required":["email"]}}}}}},"/api/lists":{"get":{"summary":"Get the list of contact