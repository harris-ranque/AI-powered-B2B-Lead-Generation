If 0, no list used (\"All contacts\").","required":true,"schema":{"type":"integer"},"examples":{"omitted":{"summary":"When the value is omitted","value":""},"present":{"summary":"When the value is present","value":11}}}]},"/api/search/name":{"post":{"summary":"Find from name","operationId":"findFromName","description":"Find someone's email from name and company (website or name). Uses one finder credit if a verified email is found.","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"oneOf":[{"description":"Success","type":"object","properties":{"contact":{"type":"object","properties":{"name":{"type":"string","examples":["John Doe"]},"domain":{"type":"string","examples":["website.com"]},"email":{"type":"string","examples":["john@website.com"]}}}},"examples":[{"contact":{"name":"John Doe","domain":"website.com","email":"john@website.com"}}]},{"description":"Webhook URL provided process asynchronous","type":"object","properties":{"payload":{"type":"object","properties":{"contact":{"type":"object","properties":{"name":{"type":"string","examples":["john doe"]},"email":{"type":"string","examples":["email@website.com"]},"domain":{"type":"string","examples":["website.com"]}}}},"description":"(when using webhook_url) object POST method callback request triggered when webhook_url provided. See example response"}},"examples":[{"payload":{"contact":{"name":"john doe","email":"email@website.com","domain":"website.com"}}}]}]}}}},"402":{"description":"Error : Not enough credits","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Not enough credits"]}},"examples":[{"error":"Not enough credits"}]}}}},"423":{"description":"Error : Subscription is paused","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Subscription is paused"]}},"examples":[{"error":"Subscription is paused"}]}}}}},"tags":["Email Finder"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","description":"Person's full name","nullable":false,"examples":["John Doe"]},"domain":{"type":"string","description":"Company domain (best) or company name","nullable":false,"examples":["website.com"]},"webhook_url":{"type":"string","description":"Webhook URL that will receive the result as callback. If submitted, email search will happen in the background and notify this URL upon completion.","nullable":false,"examples":[null]}},"required":["name","domain"]}}}}}},"/api/search/domain":{"post":{"summary":"Find from domain","operationId":"findFromDomain","description":"Try finding a contact with a valid email at a given domain with a given role.\nA contact is only returned if we found a valid email.\n\nDue to the heavy processing involved (real-time search), this endpoint is limited to 5 concurrent requests (when used synchronously)\nand async jobs can take up to 24 hours to be processed depending on our workload (usually sooner).","parameters":[],"responses":{"0":{"description":"Webhook URL provided process asynchronous","content":{"application/json":{"schema":{"type":"object","properties":{"payload":{"type":"object","properties":{"contacts":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string","examples":["say my name"]},"email":{"type":"string","examples":["email@findymail.com"]},"domain":{"type":"string","examples":["domain.com"]}}},"examples":[[{"name":"say my name","email":"email@findymail.com","domain":"domain.com"}]]}},"description":"(when using webhook_url) object POST method callback request triggered when webhook_url provided. See example response"}},"examples":[{"payload":{"contacts":[{"name":"say my name","email":"email@findymail.com","domain":"domain.com"}]}}]}}}},"200":{"description":"","content":{"application/json":{"schema":{"type":"object","properties":{"contacts":{"type":"array","items":{"type":"object","properties":{"domain":{"type":"string","examples":["website.com"]},"email":{"type":"string","examples":["john@website.com"]},"name":{"type":"string","examples":["john doe"]}}},"examples":[[{"domain":"website.com","email":"john@website.com","name":"john doe"}]]}},"examples":[{"contacts":[{"domain":"website.com","email":"john@website.com","name":"john doe"}]}]}}}},"402":{"description":"Error : Not enough credits","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Not enough credits"]}},"examples":[{"error":"Not enough credits"}]}}}},"423":{"description":"Error : Subscription is paused","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Subscription is paused"]}},"examples":[{"error":"Subscription is paused"}]}}}}},"tags":["Email Finder"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"domain":{"type":"string","description":"Email domain","nullable":false,"examples":["domain.com"]},"roles":{"type":"array","description":"Target roles related to the given domain (max 3 roles)","items":{"type":"string"},"examples":[["CEO","Founder"]]},"webhook_url":{"type":"string","description":"Webhook URL that will receive the result as callback. If submitted, search will happen in the background and notify this URL upon completion.","nullable":false,"examples":["http://www.williamson.biz/"]}},"required":["domain","roles"]}}}}}},"/api/search/business-profile":{"post":{"summary":"Find from business profile","operationId":"findFromBusinessProfile","description":"Find someone's email from a business profile URL. Uses one finder credit if a verified email is found.\n\nThis endpoint is limited to 30 concurrent requests (when used synchronously)","parameters":[],"responses":{"0":{"description":"Webhook URL provided process asynchronous","content":{"application/json":{"schema":{"type":"object","properties":{"payload":{"type":"object","properties":{"contact":{"type":"object","properties":{"name":{"type":"string","examples":["john doe"]},"email":{"type":"string","examples":["email@website.com"]},"domain":{"type":"string","examples":["website.com"]}}}},"description":"(when using webhook_url) object POST method callback request triggered when webhook_url provided. See example response"}},"examples":[{"payload":{"contact":{"name":"john doe","email":"email@website.com","domain":"website.com"}}}]}}}},"200":{"description":"","content":{"application/json":{"schema":{"type":"object","properties":{"contact":{"type":"object","properties":{"name":{"type":"string","examples":["John Doe"]},"domain":{"type":"string","examples":["website.com"]},"email":{"type":"string","examples":["john@website.com"]}}}},"examples":[{"contact":{"name":"John Doe","domain":"website.com","email":"john@website.com"}}]}}}},"402":{"description":"Error : Not enough credits","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Not enough credits"]}},"examples":[{"error":"Not enough credits"}]}}}},"423":{"description":"Error : Subscription is paused","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Subscription is paused"]}},"examples":[{"error":"Subscription is paused"}]}}}}},"tags":["Email Finder"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"linkedin_url":{"type":"string","description":"Person's business profile URL. (can be full URL \"https://linkedin.com/in/johndoe\" or username only \"johndoe\")","nullable":false,"examples":["https://linkedin.com/in/johndoe"]},"webhook_url":{"type":"string","description":"Webhook URL that will receive the result as callback. If submitted, email search will happen in the background and notify this URL upon completion.","nullable":false,"examples":[null]}},"required":["linkedin_url"]}}}}}},"/api/search/reverse-email":{"post":{"summary":"Reverse email lookup","operationId":"reverseEmailLookup","description":"Find a business profile from an email address (work email or personal email).\n\nCredit usage:\n- Uses 1 finder credit if a profile is found (without profile data)\n- Uses 2 finder credits if a profile is found with complete profile data (only if `with_profile` option enabled)","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"oneOf":[{"description":"Without profile enrichment","type":"object","properties":{"linkedin_url":{"type":"string","examples":["https://linkedin.com/in/johndoe"]}},"examples":[{"linkedin_url":"https://linkedin.com/in/johndoe"}]},{"description":"With profile enrichment","type":"object","properties":{"fullName":{"type":"string","examples":["John Doe"]},"username":{"type":"string","examples":["johndoe"]},"headline":{"type":"string","examples":["CEO at Example"]},"jobTitle":{"type":"string","examples":["CEO"]},"summary":{"type":"string","examples":["Summary"]},"city":{"type":"string","examples":["City"]},"region":{"type":"string","examples":["Region"]},"country":{"type":"string","examples":["Country"]},"companyLinkedinUrl":{"type":"string","examples":["https://linkedin.com/company/example"]},"companyName":{"type":"string","examples":["Example"]},"companyWebsite":{"type":"string","examples":["example.com"]},"isPremium":{"type":"boolean","examples":[true]},"isOpenProfile":{"type":"boolean","examples":[true]},"skills":{"type":"array","examples":[[]]},"jobs":{"type":"array","examples":[[]]}},"examples":[{"fullName":"John Doe","username":"johndoe","headline":"CEO at Example","jobTitle":"CEO","summary":"Summary","city":"City","region":"Region","country":"Country","companyLinkedinUrl":"https://linkedin.com/company/example","companyName":"Example","companyWebsite":"example.com","isPremium":true,"isOpenProfile":true,"skills":[],"jobs":[]}]},{"description":"No LinkedIn URL found","type":"object","properties":{"linkedin_url":{"type":"string","examples":[null]}},"examples":[{"linkedin_url":null}]}]}}}},"402":{"description":"Error : Not enough credits","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Not enough credits"]}},"examples":[{"error":"Not enough credits"}]}}}},"423":{"description":"Error : Subscription is paused","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Subscription is paused"]}},"examples":[{"error":"Subscription is paused"}]}}}}},"tags":["Misc"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","description":"Email address to lookup","nullable":false,"examples":["john@example.com"]},"with_profile":{"type":"boolean","description":"optional Whether to return profile metadata (default: false)","nullable":false,"examples":[false]}},"required":["email"]}}}}}},"/api/search/employees":{"post":{"summary":"Find employees","operationId":"findEmployees","description":"Find one or more employees using the company website and job title.\n\nThis endpoint uses 1 credit per found contact.\n\nThis endpoint does NOT return an email.","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"type":"object"},"examples":[[{"name":"John Done","linkedinUrl":"https://www.linkedin.com/in/john-doe/","companyWebsite":"https://www.findymail.com","companyName":"Findymail","jobTitle":"Software Engineer"}]]}}}},"402":{"description":"Error : Not enough credits","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Not enough credits"]}},"examples":[{"error":"Not enough credits"}]}}}},"423":{"description":"Error : Subscription is paused","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Subscription is paused"]}},"examples":[{"error":"Subscription is paused"}]}}}}},"tags":["Misc"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"website":{"type":"string","description":"company website","nullable":false,"examples":["google.com"]},"job_titles":{"type":"array","description":"target job titles (max 10)","items":{"type":"string"},"examples":[["Software Engineer","CEO"]]},"count":{"type":"integer","description":"Number of contacts to return (max 5). Default 1.","nullable":false,"examples":[2]}},"required":["website","job_titles"]}}}}}},"/api/search/phone":{"post":{"summary":"Find phone","operationId":"findPhone","description":"Find someone's phone number from a business profile URL. Uses 10 finder credits if a phone is found.\n\nFor legal reasons, requests for EU citizens will not return any result.","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"object","properties":{"phone":{"type":"string","examples":["+1234567890"]}},"examples":[{"phone":"+1234567890"}]}}}},"402":{"description":"Error : Not enough credits","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Not enough credits"]}},"examples":[{"error":"Not enough credits"}]}}}},"423":{"description":"Error : Subscription is paused","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","examples":["Subscription is paused"]}},"examples":[{"error":"Subscription is paused"}]}}}}},"tags":["Phone Finder"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"linkedin_url":{"type":"string","description":"Person's business profile URL. (can be full URL \"https://linkedin.com/in/johndoe\" or username only \"johndoe\")","nullable":false,"examples":["https://linkedin.com/in/johndoe"]}},"required":["linkedin_url"]}}}}}},"/api/credits":{"get":{"summary":"Get remaining credits","operationId":"getRemainingCredits","description":"","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"object","properties":{"credits":{"type":"integer","examples":[150]},"verifier_credits":{"type":"integer","examples":[100]}},"examples":[{"credits":150,"verifier_credits":100}]}}}}},"tags":["User"]}}}}