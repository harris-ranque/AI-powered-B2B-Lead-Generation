# Multi-stage build for Genni web app from monorepo root
FROM node:18-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@latest

# Copy root package files and install all dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY README.md ./
COPY docs/ docs/
COPY apps/ apps/
COPY packages/ packages/

# Install all dependencies for the monorepo
RUN pnpm install

# Accept build-time environment variables for Vite
ARG CONVEX_DEPLOYMENT
ARG VITE_CONVEX_URL
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_POSTHOG_KEY
ARG VITE_POSTHOG_HOST
ARG VITE_SUPPORT_EMAIL
ARG ENVIRONMENT=production
ARG NODE_ENV=production

# Set environment variables
ENV VITE_CONVEX_URL=$VITE_CONVEX_URL
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_POSTHOG_KEY=$VITE_POSTHOG_KEY
ENV VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
ENV ENVIRONMENT=$ENVIRONMENT
ENV NODE_ENV=$NODE_ENV

# Generate Convex types from backend (requires CONVEX_DEPLOYMENT)
WORKDIR /app/apps/convex-backend
RUN if [ -n "$CONVEX_DEPLOYMENT" ]; then \
        echo "📦 Generating Convex types for deployment: $CONVEX_DEPLOYMENT"; \
        CONVEX_DEPLOYMENT=$CONVEX_DEPLOYMENT pnpm exec convex codegen; \
    elif [ -d "convex/_generated" ]; then \
        echo "✅ Using pre-generated Convex types"; \
    else \
        echo "⚠️ WARNING: No CONVEX_DEPLOYMENT provided and no pre-generated types found"; \
    fi

# Copy generated files to web app (if they exist)
RUN if [ -d "convex/_generated" ]; then \
        cp -r convex/_generated ../web/convex/; \
        echo "✅ Copied Convex types to web app"; \
    fi

# Build the web app
WORKDIR /app/apps/web
RUN if [ "$NODE_ENV" = "development" ] || [ "$ENVIRONMENT" = "development" ]; then \
        pnpm build:dev; \
    else \
        pnpm build; \
    fi

# Production stage - serve the built app
FROM nginx:alpine
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy nginx configuration if it exists, otherwise use default
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf 2>/dev/null || echo "server { listen 80; location / { try_files \$uri \$uri/ /index.html; } }" > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]